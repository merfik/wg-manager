# wg-preset.env — WireGuard installation preset

# Required
WG_IFACE=wg0
WG_MODE=hub          # hub | full

# Hub mode required
WG_ENDPOINT=203.0.113.10

# Defaults (only override what you need)
WG_SUBNET=10.7.0.0/24
WG_PORT=51820
WG_MTU=1420
WG_KEEPALIVE=25
WG_IPV6=             # leave blank to skip
WG_DNS=system        # system|cloudflare|google|quad9|opendns|custom
WG_DNS_CUSTOM=       # set if dns=custom
WG_SPLIT_TUNNEL=no   # full mode only: yes|no
WG_SPLIT_ROUTES=     # comma-separated CIDRs if split_tunnel=yes
WG_WAN_IFACE=        # auto-detected if blank
WG_CLIENT=           # client name (for --add)
WG_PSK=no            # generate preshared key: yes|no
WG_EXPORT_DIR=       # export directory for configs
WG_QR=no             # generate QR codes: yes|no
WG_DRY_RUN=no        # preview without changes: yes|no
WG_BACKUP_FILE=      # archive path (for --restore)
